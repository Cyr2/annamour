<?xml version="1.0" encoding="utf-8"?>
<!-- Very visible focus for a 3 m viewing distance: peach fill when focused, outlined otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/peche" />
            <stroke android:width="3dp" android:color="@color/lait" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/peche" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/encre" />
            <stroke android:width="2dp" android:color="@color/lait_doux" />
        </shape>
    </item>
</selector>
